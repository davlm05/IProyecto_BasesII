# =============================================================================
# MediCitas - Variables de entorno
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_DB=medicitas
POSTGRES_KC_DB=keycloakdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=medicitasSuperuserDev
POSTGRES_HOST_PORT=5432

# -----------------------------------------------------------------------------
# Perfiles de base de datos 
# -----------------------------------------------------------------------------
MEDICITAS_OWNER_PASSWORD=medicitasOwnerDev
MEDICITAS_PLATFORM_PASSWORD=medicitasPlatformDev
MEDICITAS_CLINIC_ADMIN_PASSWORD=medicitasClinicAdminDev
MEDICITAS_RECEPTION_PASSWORD=medicitasReceptionDev
MEDICITAS_PROFESSIONAL_PASSWORD=medicitasProfessionalDev

# -----------------------------------------------------------------------------
# Keycloak
# -----------------------------------------------------------------------------
KC_ADMIN_USER=keycloakAdmin
KC_ADMIN_PASSWORD=medicitasKeycloakAdmin
KC_HOST_PORT=8080
MEDICITAS_TEST_USER_PASSWORD=medicitasDev

# -----------------------------------------------------------------------------
# Servicio de API
# -----------------------------------------------------------------------------
MEDICITAS_API_HOST_PORT=8000
MEDICITAS_LOG_LEVEL=info
MEDICITAS_DB_HOST=postgres
MEDICITAS_DB_PORT=5432
MEDICITAS_DB_POOL_SIZE=5
MEDICITAS_RESERVATION_MAX_RETRIES=3

# -----------------------------------------------------------------------------
# Validacion del token
# -----------------------------------------------------------------------------
KEYCLOAK_ISSUER=http://localhost:8080/realms/MediCitas
KEYCLOAK_JWKS_URL=http://keycloakService:8080/realms/MediCitas/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=medicitasApi
